# Copy this file to config.env (gitignored - never commit the real one)
# and fill in your own values. Every script in this folder sources
# config.env automatically, so none of these need exporting by hand.
#
#   cp config.env.example config.env

# Required. The team's chosen region.
AWS_REGION=ap-southeast-2

# Optional. Which named AWS CLI profile to use (see `aws configure list-profiles`).
# Leave blank to use whatever credentials are already active - env vars, SSO,
# or an instance/role credential - which is the normal case in CI.
AWS_PROFILE=

# Namespaces every resource this deployment creates (ECS cluster name, ECR
# repo names, IAM role names, security group names, log group names,
# Service Connect namespace) so it never collides with anything else in the
# same AWS account. Keep this the same across every script run - changing
# it later effectively starts a brand new deployment.
PROJECT_PREFIX=faculty-fms

# Set to a non-empty value to skip every "type to confirm" prompt. The
# scripts already skip prompts automatically when CI is set (GitHub
# Actions sets this itself) - this is for a human who wants the same
# behaviour locally, e.g. while iterating quickly. Leave blank normally.
SKIP_CONFIRM=
